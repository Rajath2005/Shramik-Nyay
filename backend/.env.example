GNANI_API_KEY="replace-with-your-gnani-api-key"
# Optional; use when the Hugging Face Evon model repository requires authentication.
HF_TOKEN=""
SHRAMIK_MODE="MOCK_REPLAY"
# Required to unlock LIVE microphone/provider calls. Keep this only on the backend host.
SHRAMIK_LIVE_PASSCODE="replace-with-a-long-random-passcode"
# Comma-separated browser origins allowed to call this API.
SHRAMIK_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Connection-attempt rate limit per client IP.
SHRAMIK_WS_RATE_WINDOW_SECONDS="60"
SHRAMIK_WS_RATE_MAX_CONNECTIONS="20"
# Claim artifact retention. Set to 0 to disable automatic deletion.
SHRAMIK_CLAIM_TTL_SECONDS="86400"
# Consent audio is held in memory only by default and is not included in claim files.
SHRAMIK_STORE_CONSENT_AUDIO="false"
# Per-websocket-session LIVE provider call caps.
SHRAMIK_LIVE_EVON_CAP="20"
SHRAMIK_LIVE_TIMBRE_CAP="5"
SHRAMIK_LIVE_PRISMA_CAP="20"
GNANI_API_BASE_URL="https://api.vachana.ai"
GNANI_STT_WS_URL="wss://api.vachana.ai/stt/v3/stream"
GNANI_TTS_API_URL="wss://api.vachana.ai/api/v1/tts"
# Optional Evon chat-completions override; otherwise this is derived from GNANI_API_BASE_URL.
# EVON_ENDPOINT_URL="https://api.vachana.ai/llm/evon-v3.3/chat/completions"
