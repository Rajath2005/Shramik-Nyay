<mxfile host="app.diagrams.net" modified="2026-11-05T07:15:00.000Z" agent="Shramik-Nyay" version="24.7.17">
  <diagram id="runtime-flow" name="Runtime flow">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Shramik-Nyay | Request and safety flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#17232d;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="35" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Public visitors stay on MOCK_REPLAY. LIVE is an explicit, server-authorized path with rate and credit controls." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#52606d;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="78" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="s1" value="1. Open WebSocket&lt;br&gt;&lt;br&gt;Browser connects over WSS&lt;br&gt;Backend applies per-IP connection window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4ff;strokeColor=#2487c9;strokeWidth=2;fontColor=#17324d;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="s2" value="2. Start in MOCK_REPLAY&lt;br&gt;&lt;br&gt;Synthetic transcript and profile&lt;br&gt;No provider calls&lt;br&gt;Safe public demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1edff;strokeColor=#7654c7;strokeWidth=2;fontColor=#34205f;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="decision" value="LIVE requested?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7e2;strokeColor=#d99a18;strokeWidth=2;fontColor=#4d3a0c;fontSize=17;" vertex="1" parent="1"><mxGeometry x="790" y="185" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="s3" value="3. Authenticate&lt;br&gt;&lt;br&gt;Client sends passcode command&lt;br&gt;Backend compares server-side secret&lt;br&gt;Invalid: remain blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#d96b27;strokeWidth=2;fontColor=#572610;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="1080" y="170" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="s4" value="4. Process voice turn&lt;br&gt;&lt;br&gt;Prisma: raw PCM frames&lt;br&gt;Evon: slot extraction + audit&lt;br&gt;Timbre: optional read-back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#2f9e62;strokeWidth=2;fontColor=#173d29;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="1080" y="470" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="s5" value="5. Enforce caps&lt;br&gt;&lt;br&gt;Per-session provider credit guard&lt;br&gt;Failure fallback to MOCK_REPLAY&lt;br&gt;No silent live overrun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f7;strokeColor=#66788a;strokeWidth=2;fontColor=#263746;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="790" y="470" width="220" height="170" as="geometry"/></mxCell>
        <mxCell id="s6" value="6. Prepare draft&lt;br&gt;&lt;br&gt;Deterministic arithmetic&lt;br&gt;Form A PDF + JSON&lt;br&gt;Claim directory receives TTL cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e2;strokeColor=#d99a18;strokeWidth=2;fontColor=#4d3a0c;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="420" y="470" width="260" height="170" as="geometry"/></mxCell>
        <mxCell id="s7" value="7. Consent gate&lt;br&gt;&lt;br&gt;Read-back must be accepted&lt;br&gt;before draft finalization&lt;br&gt;User can delete claim artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4ff;strokeColor=#2487c9;strokeWidth=2;fontColor=#17324d;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="260" height="170" as="geometry"/></mxCell>
        <mxCell id="e1" value="connect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2487c9;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="optional" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d99a18;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d96b27;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="decision" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2f9e62;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="provider calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#66788a;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="draft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d99a18;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="consent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2487c9;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="no: stay MOCK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7654c7;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#34205f;" edge="1" parent="1" source="decision" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
