  <diagram id="deployment-topology" name="Deployment topology">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Shramik-Nyay | Production deployment topology" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#17232d;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="35" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Use HTTPS for the frontend and WSS for the backend. Provider keys and the LIVE passcode never cross into the browser bundle." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#52606d;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="78" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;VISITOR&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browser&lt;br&gt;HTTPS&lt;br&gt;Microphone permission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4ff;strokeColor=#2487c9;strokeWidth=2;fontColor=#17324d;fontSize=17;spacing=15;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="pages" value="&lt;b&gt;STATIC HOST&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vercel / Netlify / Cloudflare Pages&lt;br&gt;Build: npm run build&lt;br&gt;Output: frontend/dist&lt;br&gt;Public VITE_WS_URL only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8ef;strokeColor=#2f9e62;strokeWidth=2;fontColor=#173d29;fontSize=16;spacing=15;" vertex="1" parent="1"><mxGeometry x="380" y="250" width="320" height="250" as="geometry"/></mxCell>
        <mxCell id="render" value="&lt;b&gt;WEBSOCKET HOST&lt;/b&gt;&lt;br&gt;&lt;br&gt;Render Web Service&lt;br&gt;Docker: backend/Dockerfile&lt;br&gt;HTTPS / WSS upgrade&lt;br&gt;/health healthcheck&lt;br&gt;PORT provided by host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e2;strokeColor=#d99a18;strokeWidth=2;fontColor=#4d3a0c;fontSize=16;spacing=15;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="320" height="290" as="geometry"/></mxCell>
        <mxCell id="env" value="&lt;b&gt;SERVER ENVIRONMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;SHRAMIK_MODE&lt;br&gt;SHRAMIK_CORS_ORIGINS&lt;br&gt;SHRAMIK_LIVE_PASSCODE&lt;br&gt;GNANI_API_KEY&lt;br&gt;credit caps + claim TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#d96b27;strokeWidth=2;fontColor=#572610;fontSize=16;spacing=15;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="320" height="220" as="geometry"/></mxCell>
        <mxCell id="gnani" value="&lt;b&gt;GNANI API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prisma STT WebSocket&lt;br&gt;Evon LLM HTTPS&lt;br&gt;Timbre TTS WebSocket&lt;br&gt;LIVE calls only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1edff;strokeColor=#7654c7;strokeWidth=2;fontColor=#34205f;fontSize=16;spacing=15;" vertex="1" parent="1"><mxGeometry x="1220" y="330" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="u1" value="browse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2487c9;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="user" target="pages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2" value="wss://.../ws/session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2487c9;strokeWidth=2;endArrow=block;endFill=1;fontColor=#17324d;" edge="1" parent="1" source="pages" target="render"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3" value="env + secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d96b27;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#572610;" edge="1" parent="1" source="env" target="render"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4" value="server-side LIVE calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7654c7;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#34205f;" edge="1" parent="1" source="render" target="gnani"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Deployment invariant&lt;/b&gt;&lt;br&gt;Browser receives only VITE_WS_URL. GNANI_API_KEY and SHRAMIK_LIVE_PASSCODE are configured in the backend host environment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f7;strokeColor=#66788a;fontColor=#263746;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="620" width="620" height="130" as="geometry"/></mxCell>
